# Copy this file to ".env" and fill in your real keys.
# Never commit the real ".env" file.

# --- Google Gemini (required) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: change the model without touching any code
GEMINI_MODEL=gemini-2.0-flash

# --- Embeddings (optional override) ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Paths (optional overrides) ---
PDF_DIR=data/pdfs
VECTOR_DB_PATH=vector_db

# --- Retrieval / chunking (optional overrides) ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=4

# --- Bhashini (optional - primary translation provider) ---
# Register at https://bhashini.gitbook.io/bhashini-apis to get these.
# If left blank, translate() automatically falls back to a Gemini-based
# translation call, so /translate keeps working end-to-end.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
